```gitignore
# Build output
/build/
/cmake-build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CTestTestfile.cmake
compile_commands.json

# Compiled binaries and object files
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.out

# Debugging files
core
core.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

# OS-generated files
.DS_Store
Thumbs.db
```
